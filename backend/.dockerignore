# Keep the build context (and therefore the image) to runtime essentials only.

# --- Python artefacts ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Tests, CI helpers and their fixtures (not needed at runtime) ---
tests/
scripts/
.pytest_cache/
.coverage
htmlcov/
build/

# --- Tooling caches ---
.mypy_cache/
.ruff_cache/

# --- Docs and local config ---
*.md
.env
.env.*
!.env.example

# --- Docker's own files ---
Dockerfile
.dockerignore
