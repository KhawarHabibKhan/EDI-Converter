# ---------- Python (backend) ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# FHIR Bundles exported for CI conformance validation
backend/build/
# HL7 validator CLI, if downloaded locally to reproduce the CI gate
validator_cli.jar

# ---------- Node / Vite (frontend) ----------
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
# compiled config emitted by tsc -b
frontend/vite.config.js
frontend/vite.config.d.ts

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example
*.local

# ---------- Editors / IDEs ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Docs & notes (kept out of the repo) ----------
# Planning / design documents live outside version control.
docx/

# Stray markdown — scratch notes, proposals, recommendations, hand-offs.
# README.md is the exception: it is the entry point for the repo. The pattern
# has no slash, so this keeps every README.md at any depth (including
# backend/engine/validation/codesets/README.md, which documents the code sets
# next to the loader that reads them).
*.md
!README.md

# Delivered documentation — tracked on purpose, despite the *.md rule above.
# Add a line here for any doc that is a product deliverable rather than a note.
!docs/user-guide.md
!docs/case-study.md
!docs/testing-plan.md

.claude/