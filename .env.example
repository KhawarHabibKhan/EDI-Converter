# Backend
EDI_MAX_FILE_MB=10

# Logging. Request logs record method, path, status, duration and upload size —
# never body content or filenames, both of which can carry PHI.
EDI_LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR
EDI_LOG_FORMAT=text     # text | json  (json for log shippers)
EDI_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend (build-time)
VITE_API_URL=http://localhost:5080
